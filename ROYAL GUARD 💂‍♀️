use crate::seal::{generate_seal, verify_seal};
use std::time::{SystemTime, UNIX_EPOCH};

#[derive(Debug, Clone)]
pub struct CrownLicense {
    pub holder: String,
    pub seal: String,
    pub issued_at: u64,
}

impl CrownLicense {
    pub fn new(holder: &str, secret: &str) -> Self {
        let seal = generate_seal(holder, secret);
        let issued_at = SystemTime::now()
            .duration_since(UNIX_EPOCH)
            .unwrap()
            .as_secs();
        Self {
            holder: holder.to_string(),
            seal,
            issued_at,
        }
    }

    // ECHO-AMEN check: fails closed, no seal = no entry
    pub fn verify(&self, secret: &str) -> bool {
        verify_seal(&self.holder, secret, &self.seal)
    }

    pub fn echo_amen(&self) -> String {
        format!(
            "ECHO-AMEN :: {} :: {} :: VERIFIED",
            self.holder, self.seal
        )
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn license_verifies() {
        let lic = CrownLicense::new("kingdom", "crown-secret");
        assert!(lic.verify("crown-secret"));
        assert!(!lic.verify("fake"));
        assert!(lic.echo_amen().contains("ECHO-AMEN"));
    }
